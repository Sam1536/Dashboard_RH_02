table _Medidas
	lineageTag: 056efebf-2509-4e77-89d3-59b7a17ff41a

	measure 'Total Contratações' = COUNTROWS(BaseFuncionarios )
		formatString: 0
		lineageTag: e070370a-f0fb-4402-8119-4b5431494fab

	measure 'Funcionarios Ativos' = ```
			CALCULATE(
			    COUNTROWS(
			        BaseFuncionarios),
			        BaseFuncionarios[Data de Demissao] = BLANK()
			)
			
			```
		formatString: 0
		lineageTag: 519267d1-41b2-4a52-82f7-d5e9b9ab3edf

	measure 'Total Demissões' = [Total Contratações] - [Funcionarios Ativos]
		formatString: 0
		lineageTag: 0945242c-5803-4fd4-91fb-99c14ce0d54e

	measure '% Turnover' = [Total Demissões] / [Total Contratações]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ec1542ff-464d-4aa2-82ed-1ad54654dc78

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

